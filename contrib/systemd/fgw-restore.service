# firegeowall: fill the (empty) nftables sets from the local cache right after
# the ruleset is loaded. No network needed. Also re-runs whenever nftables.service
# is restarted (PartOf) or reloaded (ReloadPropagatedFrom + ExecReload), because
# the `flush ruleset` in /etc/nftables.conf empties the sets. PartOf does not
# cover a plain start after a stop; WantedBy=nftables.service does.
# Neither Requires= nor Requisite= on nftables.service: Requires= starts it when
# inactive, and its `flush ruleset` wipes rules other tools (Docker, ufw, ...)
# loaded. Requisite= together with WantedBy= makes the two units pull each other
# in, so starting *any* service started a stopped nftables again. Without the
# table, fgw fails and changes nothing, so After= is all the ordering needed.
[Unit]
Description=firegeowall: restore country block sets from cache
Documentation=https://github.com/TZERO78/firegeowall
After=nftables.service
PartOf=nftables.service
ReloadPropagatedFrom=nftables.service
Before=network-online.target
ConditionPathExists=/etc/firegeowall/config.yml
ConditionPathExists=/var/lib/firegeowall/zones

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/fgw apply --from-cache
ExecReload=/usr/sbin/fgw apply --from-cache
User=fgw
Group=fgw
StateDirectory=firegeowall
StateDirectoryMode=0755
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_NETLINK AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
ReadOnlyPaths=/etc/firegeowall

[Install]
WantedBy=multi-user.target nftables.service
