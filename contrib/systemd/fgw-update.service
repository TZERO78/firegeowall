# firegeowall: weekly refresh of the country range lists and the nftables sets.
# Triggered by fgw-update.timer. Needs network.
[Unit]
Description=firegeowall: refresh country block sets
Documentation=https://github.com/TZERO78/firegeowall
After=network-online.target nftables.service
Wants=network-online.target
Requires=nftables.service
ConditionPathExists=/etc/firegeowall/config.yml

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/fgw update
User=fgw
Group=fgw
StateDirectory=firegeowall
StateDirectoryMode=0750
# nftables is driven over netlink; CAP_NET_ADMIN is all that needs.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Only the state directory is writable; the config is read-only here.
ReadOnlyPaths=/etc/firegeowall
